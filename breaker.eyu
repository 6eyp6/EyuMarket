REM ================================
REM  EyuScript - Buyuk Yazili Kronometre
REM ================================

CLEAR 0
SETCURSOR 100 20
PRINTLN "KRONOMETRE"
SHOW

SET toplamSaniye 0

:tik
  REM Dakika ve saniyeyi hesapla
  SET dk toplamSaniye
  DIV dk 60

  SET sn toplamSaniye
  MOD sn 60

  REM Eski yaziyi temizle (buyuk kutu)
  RECT 100 100 200 80 0

  REM "Kalin" gorunum icin ayni metni ust uste, hafif kaydirarak yaz
  SETCURSOR 120 120
  PRINT dk
  PRINT ":"
  PRINT sn

  SETCURSOR 121 120
  PRINT dk
  PRINT ":"
  PRINT sn

  SETCURSOR 120 121
  PRINT dk
  PRINT ":"
  PRINT sn

  REM Cerceve
  RECTOUT 90 95 220 90 2047

  SHOW

  WAIT 1000
  ADD toplamSaniye 1

GOTO tik